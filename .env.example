# Copy this file to .env to override the safe local defaults.
APP_NAME=cloudops-api
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# Replace the placeholders only in your local .env file. Percent-encode special
# password characters when they are used inside a URL.
DATABASE_URL=postgresql+psycopg://cloudops_app:YOUR_PASSWORD@localhost:5432/cloudops_status

# Docker Compose initializes its own PostgreSQL container with these values.
POSTGRES_DB=cloudops_status
POSTGRES_USER=cloudops_app
POSTGRES_PASSWORD=YOUR_DOCKER_DATABASE_PASSWORD
